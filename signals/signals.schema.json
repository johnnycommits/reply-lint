{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://johnnycommits.github.io/reply-lint/signals.schema.json",
  "title": "Reply Lint signals",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schemaVersion",
    "defaultSignalsUrl",
    "caveat",
    "source",
    "weights",
    "replyRisks",
    "watchedPaths",
    "checks"
  ],
  "properties": {
    "schemaVersion": { "const": 1 },
    "defaultSignalsUrl": { "type": "string", "pattern": "^https://" },
    "caveat": { "type": "string", "minLength": 1 },
    "source": { "$ref": "#/$defs/pin" },
    "weights": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/weight" }
    },
    "replyRisks": {
      "type": "array",
      "minItems": 1,
      "items": { "$ref": "#/$defs/risk" }
    },
    "watchedPaths": {
      "type": "array",
      "minItems": 1,
      "items": { "type": "string", "minLength": 1 }
    },
    "checks": { "$ref": "#/$defs/checks" }
  },
  "$defs": {
    "lines": {
      "type": "array",
      "minItems": 2,
      "maxItems": 2,
      "items": { "type": "integer", "minimum": 1 },
      "prefixItems": [
        { "type": "integer", "minimum": 1 },
        { "type": "integer", "minimum": 1 }
      ]
    },
    "citation": {
      "type": "object",
      "additionalProperties": false,
      "required": ["path", "lines"],
      "properties": {
        "path": { "type": "string", "minLength": 1 },
        "lines": { "$ref": "#/$defs/lines" },
        "note": { "type": "string" },
        "label": { "type": "string", "minLength": 1 }
      }
    },
    "pin": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "repo",
        "url",
        "commit",
        "commitDate",
        "commitTimeUtc",
        "researchedAt"
      ],
      "properties": {
        "repo": { "type": "string", "pattern": "^[A-Za-z0-9_.-]+/[A-Za-z0-9_.-]+$" },
        "url": { "type": "string", "pattern": "^https://" },
        "commit": { "type": "string", "pattern": "^[0-9a-f]{40}$" },
        "commitDate": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" },
        "commitTimeUtc": { "type": "string", "minLength": 1 },
        "researchedAt": { "type": "string", "pattern": "^\\d{4}-\\d{2}-\\d{2}$" }
      }
    },
    "weight": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "label", "weight", "path", "lines"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "label": { "type": "string", "minLength": 1 },
        "weight": { "type": "number" },
        "path": { "type": "string", "minLength": 1 },
        "lines": { "$ref": "#/$defs/lines" },
        "note": { "type": "string" }
      }
    },
    "risk": {
      "type": "object",
      "additionalProperties": false,
      "required": ["id", "summary", "sources"],
      "properties": {
        "id": { "type": "string", "minLength": 1 },
        "summary": { "type": "string", "minLength": 1 },
        "sources": {
          "type": "array",
          "minItems": 1,
          "items": { "$ref": "#/$defs/citation" }
        }
      }
    },
    "checks": {
      "type": "object",
      "additionalProperties": false,
      "required": [
        "typedNotPasted",
        "soundsHuman",
        "engagementBait",
        "spamHashtags",
        "spamMentions",
        "spamLinks",
        "spamDuplicate",
        "replyPace",
        "invitesConversation",
        "infoLength",
        "infoMedia"
      ],
      "properties": {
        "typedNotPasted": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "source",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "x-code" },
            "enabledByDefault": { "type": "boolean" },
            "source": { "$ref": "#/$defs/citation" },
            "reasonPass": { "type": "string", "minLength": 1 },
            "reasonWarn": { "type": "string", "minLength": 1 }
          }
        },
        "soundsHuman": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "related",
            "openers",
            "phrases",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "heuristic" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string", "minLength": 1 },
            "related": { "$ref": "#/$defs/citation" },
            "openers": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "phrases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "reasonPass": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "engagementBait": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "source",
            "detectorNote",
            "phrases",
            "reasonPass",
            "reasonFail"
          ],
          "properties": {
            "title": { "type": "string", "minLength": 1 },
            "tag": { "const": "x-code" },
            "enabledByDefault": { "type": "boolean" },
            "source": { "$ref": "#/$defs/citation" },
            "detectorNote": { "type": "string", "minLength": 1 },
            "phrases": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "reasonPass": { "type": "string", "minLength": 1 },
            "reasonFail": { "type": "string", "minLength": 1 }
          }
        },
        "spamHashtags": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "related",
            "maxHashtags",
            "reasonPass",
            "reasonPassPlural",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "heuristic" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "related": { "$ref": "#/$defs/citation" },
            "maxHashtags": { "type": "integer", "minimum": 0 },
            "reasonPass": { "type": "string" },
            "reasonPassPlural": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "spamMentions": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "related",
            "maxMentions",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "heuristic" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "related": { "$ref": "#/$defs/citation" },
            "maxMentions": { "type": "integer", "minimum": 0 },
            "reasonPass": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "spamLinks": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "related",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "heuristic" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "related": { "$ref": "#/$defs/citation" },
            "reasonPass": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "spamDuplicate": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "source",
            "minChars",
            "reasonPass",
            "reasonSkip",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "mixed" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "source": { "$ref": "#/$defs/citation" },
            "minChars": { "type": "integer", "minimum": 1 },
            "reasonPass": { "type": "string" },
            "reasonSkip": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "replyPace": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "source",
            "defaultPerHour",
            "defaultPerDay",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "mixed" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "source": { "$ref": "#/$defs/citation" },
            "defaultPerHour": { "type": "integer", "minimum": 0 },
            "defaultPerDay": { "type": "integer", "minimum": 0 },
            "reasonPass": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "invitesConversation": {
          "type": "object",
          "additionalProperties": false,
          "required": [
            "title",
            "tag",
            "enabledByDefault",
            "heuristicNote",
            "experiencePatterns",
            "reasonPass",
            "reasonWarn"
          ],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "heuristic" },
            "enabledByDefault": { "type": "boolean" },
            "heuristicNote": { "type": "string" },
            "experiencePatterns": {
              "type": "array",
              "minItems": 1,
              "items": { "type": "string", "minLength": 1 }
            },
            "reasonPass": { "type": "string" },
            "reasonWarn": { "type": "string" }
          }
        },
        "infoLength": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "tag", "related", "reason"],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "info" },
            "related": { "$ref": "#/$defs/citation" },
            "reason": { "type": "string" }
          }
        },
        "infoMedia": {
          "type": "object",
          "additionalProperties": false,
          "required": ["title", "tag", "related", "reasonOn", "reasonOff"],
          "properties": {
            "title": { "type": "string" },
            "tag": { "const": "info" },
            "related": { "$ref": "#/$defs/citation" },
            "reasonOn": { "type": "string" },
            "reasonOff": { "type": "string" }
          }
        }
      }
    }
  }
}
